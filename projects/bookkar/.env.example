# === License Server ===
# Telegram bot token (get from @BotFather)
TELOXIDE_TOKEN=your_telegram_bot_token_here

# JWT secret for signing license tokens
JWT_SECRET=change-this-to-a-strong-random-secret

# SQLite database path
DATABASE_URL=sqlite:tatkal_licenses.db?mode=rwc

# REST API port for token validation
API_PORT=8080

# UPI ID for receiving payments
PAYMENT_UPI_ID=yourupi@bank

# === Client ===
# License server URL (for token validation)
LICENSE_SERVER=http://localhost:8080

# Optional: Custom Chrome or Chromium binary path (if not in standard PATH)
# CHROME_BIN=/usr/bin/chromium

# Log level
RUST_LOG=tatkal=info

# === Fast Testing Configuration (avoids entering inputs each time) ===
# IRCTC_USERNAME=your_username
# IRCTC_PASSWORD=your_password
# LICENSE_TOKEN=your_token   # If left empty, auto-fetches dev token from license server!
# AUTO_CONFIRM=true          # Automatically accepts saved config and confirms launch
